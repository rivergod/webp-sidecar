# 줄바꿈은 저장소에 LF로 저장하고 작업 트리에서도 LF를 쓴다(Windows 포함).
# Windows 전용 스크립트만 CRLF로 둔다.
* text=auto eol=lf

*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Unix 셸 스크립트는 Windows에서 체크아웃해도 LF를 유지해야 실행된다.
*.sh     text eol=lf
gradlew  text eol=lf
mvnw     text eol=lf

# 바이너리: 줄바꿈 변환과 텍스트 diff를 하지 않는다.
*.webp  binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.bmp   binary
*.tif   binary
*.tiff  binary
*.ico   binary
*.icc   binary
*.icm   binary
*.jar   binary
*.zip   binary
*.gz    binary
*.pdf   binary
*.bin   binary
